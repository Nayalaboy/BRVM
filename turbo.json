{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SGI_REFERRAL_URL",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "NEXT_PUBLIC_PLAUSIBLE_SRC",
        "PIPELINE_API_URL",
        "EMAIL_PROVIDER",
        "BUTTONDOWN_API_KEY",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
