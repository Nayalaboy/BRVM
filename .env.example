# Aqlee Invest — Phase 0 environment reference.
# Two components, two env scopes:
#   • pipeline/ (Python) reads BRVM_*  → copy relevant vars into pipeline/.env
#   • web/      (Next.js) reads the rest → copy into web/.env.local
# Local defaults let `make bootstrap` (pipeline) and `pnpm dev` (web) run with
# zero configuration.

# --- Pipeline (Python) -----------------------------------------------------
# SQLite locally by default; set a Postgres DSN in prod.
# BRVM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/brvm
# Failure alerts (optional)
# BRVM_RESEND_API_KEY=
# BRVM_ALERT_EMAIL_TO=you@example.com
# Object storage for BOC PDFs (optional; local filesystem otherwise)
# BRVM_STORAGE_BACKEND=s3
# BRVM_S3_BUCKET= / BRVM_S3_ENDPOINT_URL= / BRVM_S3_ACCESS_KEY_ID= / BRVM_S3_SECRET_ACCESS_KEY=
# Official sources (override when BRVM moves a section)
# BRVM_REGISTRY_URL=          # CREPMF SGI list
# BRVM_BOC_LISTING_PATH=/fr/bulletins-officiels-de-la-cote

# --- Web (Next.js) ---------------------------------------------------------
# Read-only pipeline API the site consumes.
PIPELINE_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "Open an account" outbound link (no data passed).
NEXT_PUBLIC_SGI_REFERRAL_URL=https://example-sgi.example.com

# Email capture — leave EMAIL_PROVIDER unset in dev (subscribe is a no-op).
# EMAIL_PROVIDER=buttondown        # or "resend"
# BUTTONDOWN_API_KEY=
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# Privacy-friendly analytics (optional; renders nothing when unset).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aqlee.invest
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
