# --- Database (local docker-compose default) ------------------------------
DATABASE_URL=postgresql://brvm:brvm@localhost:5432/brvm

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Plain referral link to a partner SGI ("open an account" CTA). No data is passed.
NEXT_PUBLIC_SGI_REFERRAL_URL=https://example-sgi.example.com

# --- Auth (Auth.js v5) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Google OAuth (optional in dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend magic-link email sign-in (optional in dev)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=BRVM Research <onboarding@resend.dev>
# Dev-only passwordless login (never enable in production)
AUTH_DEV_LOGIN=true

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the Premium plan (create in the Stripe dashboard, test mode)
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Days of premium access kept after a failed payment
BILLING_GRACE_PERIOD_DAYS=7

# --- AI (step 2+) ----------------------------------------------------------
ANTHROPIC_API_KEY=
# Monthly Anthropic budget cap in USD (worker + copilot enforce this)
ANTHROPIC_BUDGET_USD=100
