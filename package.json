{
  "name": "brvm",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @brvm/db generate",
    "db:migrate": "pnpm --filter @brvm/db migrate",
    "db:seed": "pnpm --filter @brvm/db seed",
    "setup:local": "docker compose up -d db --wait && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  }
}
